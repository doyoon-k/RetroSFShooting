[sub_resource type="Resource" id="Page0"]
script = ExtResource("Page")
illustration = ExtResource("Image0")
caption = "둘만의 귀환"
text = "마지막 인간과 P6만이 돌아왔다.\nP6는 지친 동료에게 조용히 음료를 건넸다."

[sub_resource type="Resource" id="Page1"]
script = ExtResource("Page")
illustration = ExtResource("Image1")
caption = "휴식"
text = "“이제 쉬셔도 됩니다.”\nP6가 힘이 풀린 동료를 부축해 눕혔다."

[sub_resource type="Resource" id="Page2"]
script = ExtResource("Page")
illustration = ExtResource("Image2")
caption = "편안한 음악"
text = "눈을 감자, 어디선가 편안한 음악이 들려왔다."

[sub_resource type="Resource" id="Page3"]
script = ExtResource("Page")
illustration = ExtResource("Image3")
caption = "인류 보존 절차"
text = "눈을 뜬 곳은 조종석이 아니었다.\n“인류 보존의 최적 해를 실행합니다.” P6가 다음 절차를 준비했다."

[resource]
script = ExtResource("Script")
title = "ENDING 03 / 보존 명령"
pages = Array[ExtResource("Page")]([SubResource("Page0"), SubResource("Page1"), SubResource("Page2"), SubResource("Page3")])
