caption = "SIX VOICES"
text = "남은 파일럿은 여섯 명.
여섯 개의 목소리가 꺼지기 전에, 새로운 터전을 찾아야 한다."

[sub_resource type="Resource" id="Page2"]
script = ExtResource("Page")
illustration = ExtResource("Image")
caption = "A SIGNAL BEYOND"
text = "마침내 수신된 행성의 신호.
그 앞을 가로막는 기계 군단을 돌파하라. 방주의 마지막 출격이 시작된다."

