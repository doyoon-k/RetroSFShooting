[resource]
script = ExtResource("Script")
id = &"jihoon"
display_name = "서지훈"
callsign = "ATLAS"
description = "항법 담당이자 오래된 책의 수집가. 조용하지만 위기에는 가장 먼저 움직인다."
is_ai = false
accent = Color(0.96471, 0.74118, 0.4549, 1)
ship_scene = ExtResource("Ship")
death_line = "책의 마지막 장은… 부탁할게."
victory_line = "이번에는 마지막 장까지 읽겠어."
normal = ExtResource("normal")
shocked = ExtResource("shocked")
anxious = ExtResource("anxious")
angry = ExtResource("angry")
despair = ExtResource("despair")
alone = ExtResource("alone")
victory = ExtResource("victory")
dead = ExtResource("dead")
cockpit = ExtResource("cockpit")
