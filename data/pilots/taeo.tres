[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/data/pilot_data.gd" id="Script"]
[ext_resource type="PackedScene" path="res://scenes/player/taeo_ship.tscn" id="Ship"]
[ext_resource type="Texture2D" path="res://assets/Pilots_sprites/pilots/taeo_normal.svg" id="normal"]
[ext_resource type="Texture2D" path="res://assets/Pilots_sprites/pilots/taeo_shocked.svg" id="shocked"]
[ext_resource type="Texture2D" path="res://assets/Pilots_sprites/pilots/taeo_anxious.svg" id="anxious"]
[ext_resource type="Texture2D" path="res://assets/Pilots_sprites/pilots/taeo_angry.svg" id="angry"]
[ext_resource type="Texture2D" path="res://assets/Pilots_sprites/pilots/taeo_despair.svg" id="despair"]
[ext_resource type="Texture2D" path="res://assets/Pilots_sprites/pilots/taeo_alone.svg" id="alone"]
