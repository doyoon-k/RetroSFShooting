[resource]
script = ExtResource("Script")
rules = ExtResource("Rules")
intro = ExtResource("Intro")
pilots = Array[ExtResource("PilotType")]([ExtResource("serin"), ExtResource("jihoon"), ExtResource("haeon"), ExtResource("taeo"), ExtResource("narae"), ExtResource("echo")])
endings = Array[ExtResource("EndingType")]([ExtResource("extinction"), ExtResource("last_signal"), ExtResource("betrayal"), ExtResource("unknown_horizon"), ExtResource("cost_of_dawn"), ExtResource("new_home")])
