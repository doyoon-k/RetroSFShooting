[ext_resource type="Script" path="res://scripts/data/ending_data.gd" id="EndingType"]
[ext_resource type="Resource" path="res://data/rules/default.tres" id="Rules"]
[ext_resource type="Resource" path="res://data/stories/intro.tres" id="Intro"]
[ext_resource type="Resource" path="res://data/pilots/serin.tres" id="serin"]
[ext_resource type="Resource" path="res://data/pilots/jihoon.tres" id="jihoon"]
[ext_resource type="Resource" path="res://data/pilots/haeon.tres" id="haeon"]
[ext_resource type="Resource" path="res://data/pilots/taeo.tres" id="taeo"]
[ext_resource type="Resource" path="res://data/pilots/narae.tres" id="narae"]
[ext_resource type="Resource" path="res://data/pilots/echo.tres" id="echo"]
