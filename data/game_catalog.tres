[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://scripts/data/game_catalog.gd" id="Script"]
[ext_resource type="Script" path="res://scripts/data/pilot_data.gd" id="PilotType"]
[ext_resource type="Script" path="res://scripts/data/ending_data.gd" id="EndingType"]
[ext_resource type="Resource" path="res://data/rules/default.tres" id="Rules"]
[ext_resource type="Resource" path="res://data/stories/intro.tres" id="Intro"]
[ext_resource type="Resource" path="res://data/pilots/P1.tres" id="P1"]
[ext_resource type="Resource" path="res://data/pilots/P2.tres" id="P2"]
[ext_resource type="Resource" path="res://data/pilots/P3.tres" id="P3"]
[ext_resource type="Resource" path="res://data/pilots/P4.tres" id="P4"]
[ext_resource type="Resource" path="res://data/pilots/P5.tres" id="P5"]
[ext_resource type="Resource" path="res://data/pilots/P6.tres" id="P6"]
[ext_resource type="Resource" path="res://data/endings/extinction.tres" id="extinction"]
[ext_resource type="Resource" path="res://data/endings/last_signal.tres" id="last_signal"]
[ext_resource type="Resource" path="res://data/endings/betrayal.tres" id="betrayal"]
